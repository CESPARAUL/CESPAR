DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:3000

ACCESS_TOKEN_LIFETIME_DAYS=7

# Primary transport — Resend's HTTP API. Set this and emails skip SMTP
# entirely (recommended on hosts like Render that hang on outbound SMTP).
RESEND_API_KEY=your-resend-api-key

# SMTP fallback — only used when RESEND_API_KEY above is unset.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=CESPAR <no-reply@cespar.space>

FRONTEND_BASE_URL=http://localhost:3000
